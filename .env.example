# Copie este archivo como .env y complete los valores. El archivo .env no se sube al repositorio.
HOLO_ENTORNO=desarrollo
# Proveedor del modelo de lenguaje. "eco" no usa ningún modelo.
HOLO_PROVEEDOR_LLM=eco
# Clave del proveedor del modelo. Nunca se escribe en el código ni se comparte en el chat del equipo.
HOLO_LLM_API_KEY=
# Orígenes permitidos para CORS, separados por coma.
HOLO_ORIGENES_CORS=*

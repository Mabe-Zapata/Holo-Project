# Copie este archivo como .env y complete los valores. El archivo .env no se sube al repositorio.
HOLO_ENTORNO=desarrollo
# Proveedor del modelo de lenguaje. "eco" no usa ningún modelo.
HOLO_PROVEEDOR_LLM=eco
# Clave del proveedor del modelo. Nunca se escribe en el código ni se comparte en el chat del equipo.
HOLO_LLM_API_KEY=
# Orígenes permitidos para CORS, separados por coma.
HOLO_ORIGENES_CORS=*
# Nivel de los registros de Holo: DEBUG, INFO, WARNING o ERROR. Nunca incluyen el texto de los mensajes.
HOLO_NIVEL_REGISTROS=INFO

HOLO_DB_USUARIO=holo
HOLO_DB_CLAVE=cambiar_esta_clave
HOLO_DB_NOMBRE=holo
HOLO_DB_PUERTO=5432
HOLO_URL_BASE_DATOS=postgresql+psycopg://holo:cambiar_esta_clave@localhost:5432/holo